{
  "name": "portfolio",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run optimize:photos && vite dev",
    "optimize:photos": "node scripts/optimize-photos.js",
    "build": "npm run optimize:photos && vite build",
    "preview": "svelte-kit preview",
    "export": "npm run build && touch build/.nojekyll && rm -f build/.DS_Store",
    "build:site": "./build-site.sh",
    "deploy": "./deploy.sh",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
    "format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@propfull/kit": "0.0.0-alpha.13",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@types/eslint": "^9.6.1",
    "@types/luxon": "^3.7.2",
    "@types/superagent": "^8.1.10",
    "@urql/core": "^6.0.2",
    "@vanillawc/wc-markdown": "^1.6.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "graphql": "^17.0.1",
    "luxon": "^3.7.2",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^3.3.3",
    "sharp": "^0.35.3",
    "superagent": "^10.3.0",
    "svelte": "^4.2.7",
    "svelte-awesome": "^3.3.5",
    "svelte-check": "^3.8.0",
    "svelte-markdown": "^0.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.0"
  },
  "type": "module"
}
